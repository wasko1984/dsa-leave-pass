# Copy to .env and enter your office SMTP details locally. Do not share secrets in chat.
# Use the address staff can reach. A localhost link cannot be opened on another computer.
APP_BASE_URL=https://leave.your-office.example
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Set true when the app is served over HTTPS.
COOKIE_SECURE=false
